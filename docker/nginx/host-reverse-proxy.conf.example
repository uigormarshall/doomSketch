# Reverse proxy do nginx do HOST (Ubuntu) para o container "web" do doomsketch.
# O TLS termina aqui (certbot); o container publica em 127.0.0.1:8080.
#
# Instalar no servidor:
#   sudo cp docker/nginx/host-reverse-proxy.conf.example /etc/nginx/sites-available/doomsketch
#   sudo ln -sf /etc/nginx/sites-available/doomsketch /etc/nginx/sites-enabled/doomsketch
#   sudo nginx -t && sudo systemctl reload nginx
#
# Certificado (já emitido neste host):
#   sudo certbot --nginx -d doomsketch.com.br -d www.doomsketch.com.br

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name doomsketch.com.br www.doomsketch.com.br;

    # Mantém alinhado com o upload de arte (php.ini / nginx do container).
    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    ssl_certificate /etc/letsencrypt/live/doomsketch.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doomsketch.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name doomsketch.com.br www.doomsketch.com.br;
    return 301 https://$host$request_uri;
}
